<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/portal_header_dark">

    <!-- Header (Portal Gradient) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/header_portal_gradient"
        android:padding="20dp"
        android:paddingTop="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back_arrow"
            android:background="@drawable/card_background"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="   APPLY LEAVE   "
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_portal_header"
            android:layout_marginLeft="14dp"
            android:padding="8dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp">

            <!-- Info banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/divider"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ℹ️"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Warden will call your parent before approving"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginLeft="10dp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Name (auto-filled) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etStudentName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/card_background"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textColor="@color/text_primary"
                android:alpha="0.7"
                android:enabled="false" />

            <!-- Parent Phone -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Parent Mobile Number *"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etParentPhone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/card_background"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:hint="+91 XXXXX XXXXX"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:inputType="phone"
                android:imeOptions="actionNext" />

            <!-- Reason Spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reason for Leave"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerReason"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/card_background"
                android:paddingLeft="16dp"
                android:paddingRight="16dp" />

            <EditText
                android:id="@+id/etOtherReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Please specify other reason..."
                android:padding="16dp"
                android:background="@drawable/card_background"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- Dates Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginRight="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="From Date"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etFromDate"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/card_background"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:hint="DD/MM/YYYY"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:focusable="false"
                        android:clickable="true" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginLeft="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="To Date"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etToDate"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/card_background"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:hint="DD/MM/YYYY"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:focusable="false"
                        android:clickable="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Attendance Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Attendance % (0-100) *"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etAttendance"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/card_background"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:hint="Enter the Attendance "
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:inputType="number"
                android:imeOptions="actionDone" />

            <!-- Submit -->
            <Button
                android:id="@+id/btnSubmitLeave"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="SUBMIT LEAVE REQUEST"
                android:textColor="@color/white"
                android:background="@drawable/btn_primary"
                android:layout_marginTop="30dp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:indeterminateTint="@color/brand_primary" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
