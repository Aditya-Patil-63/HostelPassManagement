<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_background"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- Icon based on notification type -->
    <TextView
        android:id="@+id/tvNotifIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="🔔"
        android:textSize="22sp"
        android:gravity="center" />

    <!-- Message + timestamp -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginLeft="12dp">

        <TextView
            android:id="@+id/tvNotifMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notification message"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvWardenName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Warden Name"
            android:textColor="@color/brand_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvRejectionReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reason: ..."
            android:textColor="@color/status_rejected"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNotifTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Just now"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Unread dot -->
    <View
        android:id="@+id/viewUnreadDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@color/brand_primary"
        android:layout_marginLeft="8dp" />

</LinearLayout>
