<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/portal_header_dark">

    <!-- Header (Portal Gradient) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/header_portal_gradient"
        android:padding="20dp"
        android:paddingTop="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back_arrow"
            android:background="@drawable/card_background"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="   APPLY OUTPASS   "
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_portal_header"
            android:layout_marginLeft="14dp"
            android:padding="8dp" />

    </LinearLayout>

    <!-- Eligibility Banner Group -->
    <LinearLayout
        android:id="@+id/bannerEligibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/divider"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvEligibilityMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You are eligible for outing today"
            android:textColor="@color/status_approved"
            android:textSize="13sp"
            android:layout_marginLeft="10dp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bannerNotEligible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/divider"
        android:padding="14dp"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❌"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvNotEligibleMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Outing not allowed today"
            android:textColor="@color/status_rejected"
            android:textSize="13sp"
            android:layout_marginLeft="10dp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="20dp">

            <!-- Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etStudentName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/card_background"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textColor="@color/text_primary"
                android:alpha="0.7"
                android:enabled="false" />

            <!-- Reason Spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reason for Outing"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerReason"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/card_background"
                android:paddingLeft="16dp"
                android:paddingRight="16dp" />

            <EditText
                android:id="@+id/etOtherReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Please specify other reason..."
                android:padding="16dp"
                android:background="@drawable/card_background"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- Times Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginRight="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Time Out"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etTimeOut"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/card_background"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:text="06:15 PM"
                        android:textColor="@color/text_primary"
                        android:alpha="0.7"
                        android:enabled="false" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginLeft="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Return Time"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etTimeIn"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/card_background"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:text="08:30 PM"
                        android:textColor="@color/text_primary"
                        android:alpha="0.7"
                        android:enabled="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Rules info -->
            <TextView
                android:id="@+id/tvOutingRules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading outing rules..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:background="@drawable/card_background"
                android:backgroundTint="#F0F0F0"
                android:padding="14dp"
                android:layout_marginTop="20dp"
                android:textStyle="italic" />

            <!-- Submit -->
            <Button
                android:id="@+id/btnSubmitOutPass"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="SUBMIT OUTPASS REQUEST"
                android:textColor="@color/white"
                android:background="@drawable/btn_primary"
                android:layout_marginTop="30dp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:indeterminateTint="@color/brand_primary" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
