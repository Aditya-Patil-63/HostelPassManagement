<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/portal_header_dark">

    <!-- Header (Portal Gradient) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/header_portal_gradient"
        android:padding="20dp"
        android:paddingTop="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back_arrow"
            android:background="@drawable/card_background"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="   REQUEST DETAIL   "
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_portal_header"
            android:layout_marginLeft="14dp"
            android:padding="8dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/portal_header_dark">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Student Photo -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivStudentPhoto"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/avatar_placeholder"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true" />

            <!-- Student Name -->
            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textColor="@color/text_secondary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_below="@id/ivStudentPhoto"
                android:layout_marginTop="12dp" />

            <!-- Status Chip -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/tab_selected"
                android:textColor="@color/white"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_below="@id/tvStudentName"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="8dp" />

            <!-- Details Card -->
            <LinearLayout
                android:id="@+id/detailsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background_dark"
                android:padding="16dp"
                android:layout_below="@id/tvStatus"
                android:layout_marginTop="20dp">

                <!-- Pass Type -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pass Type"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvPassType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <!-- Reason -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Reason"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvReason"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Duration -->
                <LinearLayout
                    android:id="@+id/rowDates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Duration"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvDates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12/04 → 14/04"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Times (Out Pass) -->
                <LinearLayout
                    android:id="@+id/rowTimes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Time"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTimes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="16:00 → 20:00"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Parent Phone -->
                <LinearLayout
                    android:id="@+id/rowParentPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Parent Phone"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvParentPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/brand_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:autoLink="phone" />

                </LinearLayout>

                <!-- Rejection Section -->
                <LinearLayout
                    android:id="@+id/rowRejectionReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"
                    android:paddingTop="12dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REJECTION REASON"
                        android:textColor="@color/status_rejected"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRejectionReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

                <!-- Student History Card (shown only to warden, below details) -->
            <LinearLayout
                android:id="@+id/cardStudentHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background_dark"
                android:padding="16dp"
                android:layout_below="@id/detailsCard"
                android:layout_marginTop="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STUDENT HISTORY"
                    android:textColor="@color/brand_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- View Attendance Button -->
                <Button
                    android:id="@+id/btnViewAttendance"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="📊 Get Attendance of the Student"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_primary"
                    android:textStyle="bold"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Warden Action Buttons -->
            <LinearLayout
                android:id="@+id/wardenActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_below="@id/cardStudentHistory"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CONFIRMATION REQUIRED"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnCallParent"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="📞  Call Parent (Confirm)"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_secondary"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btnApprove"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:text="✔  Approve"
                        android:textColor="@color/white"
                        android:background="@drawable/btn_primary"
                        android:backgroundTint="@color/status_approved"
                        android:layout_weight="1"
                        android:layout_marginRight="6dp" />

                    <Button
                        android:id="@+id/btnReject"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:text="✖  Reject"
                        android:textColor="@color/white"
                        android:background="@drawable/btn_primary"
                        android:backgroundTint="@color/status_rejected"
                        android:layout_weight="1"
                        android:layout_marginLeft="6dp" />

                </LinearLayout>

                <!-- Rejection Reason Edit -->
                <EditText
                    android:id="@+id/etRejectionReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter rejection reason..."
                    android:padding="16dp"
                    android:background="@drawable/card_background"
                    android:textColor="@color/text_secondary"
                    android:textColorHint="@color/text_hint"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnConfirmReject"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Submit Reason"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_secondary"
                    android:backgroundTint="@color/status_rejected"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/wardenActions"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:indeterminateTint="@color/brand_primary" />

        </RelativeLayout>

    </ScrollView>

</LinearLayout>
