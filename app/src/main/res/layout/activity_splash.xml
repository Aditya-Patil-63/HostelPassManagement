<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/portal_header_dark">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerInParent="true"
        android:gravity="center">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/ivAppLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/college_logo"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hostel Pass Manager"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/tvCampus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NMIMS Shirpur Campus"
            android:textColor="@color/brand_primary_light"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="64dp">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="@color/brand_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Initializing Portal Securely..."
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:textStyle="italic"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</RelativeLayout>
