<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/tvPassType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LEAVE PASS"
        android:textColor="@color/brand_primary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tvPassStudentName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student Name"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_below="@id/tvPassType"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvPassValidity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Valid: 12/04 → 14/04"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:layout_below="@id/tvPassStudentName"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvPassStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="APPROVED"
        android:textColor="@color/status_approved"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true" />

    <TextView
        android:id="@+id/tvRejectionReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reason for rejection will appear here"
        android:textColor="@color/status_rejected"
        android:textSize="11sp"
        android:layout_below="@id/tvPassValidity"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivQrCode"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_below="@id/tvRejectionReason"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

</RelativeLayout>
