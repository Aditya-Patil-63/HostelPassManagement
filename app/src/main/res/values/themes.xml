<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HostelPassManagement" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/portal_header_dark</item>
        <item name="colorAccent">@color/brand_accent</item>
        
        <item name="android:windowBackground">@color/portal_header_dark</item>
        <item name="android:statusBarColor">@color/portal_header_dark</item>
        <item name="android:navigationBarColor">@color/portal_header_dark</item>
        
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Light Theme for Login and Role Selection -->
    <style name="Theme.HostelPassManagement.Light" parent="Theme.HostelPassManagement">
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor">@color/background_light</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>